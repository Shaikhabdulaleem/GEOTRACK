# GEOTRACK variable manifest. Keep values empty in source control.
# Copy only the relevant section into the target environment.

# Web app (Figma/) — every VITE_* variable is bundled into the browser.
VITE_APP_ENV=
VITE_APP_MODE=
VITE_APP_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MAPBOX_TOKEN=

# Android app (android-app/) — client-visible BuildConfig values.
# Use only the Supabase publishable/legacy anon key; never service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APPLICATION_ID=
FIREBASE_API_KEY=
FIREBASE_SENDER_ID=

# Supabase Edge Function (send-mobile-notification) — server-side secrets.
# Configure with Supabase secrets; never put these in Vite or Android config.
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
