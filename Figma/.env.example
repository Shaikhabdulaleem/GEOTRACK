# Browser-safe Supabase configuration. Copy this file to .env.local.
# Local development defaults. Never commit a file containing real values.
VITE_APP_ENV=development
VITE_APP_MODE=live
VITE_APP_URL=http://localhost:5173

# Find these values in Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Never add a service-role or secret key to a VITE_* variable.
# Vite exposes every VITE_* value to the browser bundle.

# ── Map Tiles (optional) ────────────────────────────────────────────────────
#
# Option A — OpenStreetMap (FREE, no key required)
#   Leave VITE_MAPBOX_TOKEN blank. The geofencing map will use OSM tiles
#   via https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
#   ✅ Free forever, no account needed, no key required.
#   ⚠️  No satellite / hybrid view — street map only.
#
# Option B — Mapbox (recommended for satellite tiles)
#   1. Create a free account at https://account.mapbox.com/auth/signup/
#   2. Go to https://account.mapbox.com/ → Tokens → Create a token
#   3. Enable the "styles:tiles" and "styles:read" public scopes
#   4. Paste the token (starts with pk.) below
#   ✅ Satellite, streets, hybrid tile styles available
#   ✅ 50 000 free map loads/month on the free tier
#
VITE_MAPBOX_TOKEN=
